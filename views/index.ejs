<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f7f7f2" />
  <meta name="description" content="<%= settings.seoDescription %>" /><title><%= title %></title><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css?v=3" /><link rel="stylesheet" href="/css/commerce.css?v=3" /><link rel="stylesheet" href="/css/premium.css?v=3" /><link rel="stylesheet" href="/css/mobile.css?v=4" />
  <script src="/js/app.js?v=3" defer></script><script src="/js/storefront.js?v=3" defer></script>
</head>
<body class="home-page">
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('partials/store-header') %>
  <main id="main">
    <% const initialBanner = banners[0] || defaultBanners[0]; %>
    <section class="hero-shell" id="top" aria-label="Featured collections" aria-roledescription="carousel">
      <div class="hero page-width">
        <div class="hero-copy">
          <p class="eyebrow hero-kicker"><span class="status-dot" aria-hidden="true"></span><span id="hero-eyebrow"><%= initialBanner.eyebrow %></span></p>
          <h1 id="hero-title"><% initialBanner.title.split(/<br\s*\/?>|\n/).forEach(function(line, index) { %><% if(index) { %><br /><% } %><span><%= line %></span><% }); %></h1>
          <p class="hero-description" id="hero-description"><%= initialBanner.description %></p>
          <div class="hero-actions"><a class="button button-dark" href="<%= initialBanner.href || '/shop' %>" id="hero-cta"><span id="hero-cta-label"><%= initialBanner.cta || 'Explore the collection' %></span><span aria-hidden="true">↗</span></a><a class="text-link" href="#categories">Find your everyday <span aria-hidden="true">→</span></a></div>
          <div class="hero-assurance"><span class="assurance-symbol" aria-hidden="true">✓</span><span>Personal advice. A better way to buy.</span></div>
        </div>
        <div class="hero-visual" id="hero-visual">
          <span class="hero-orbit" aria-hidden="true"></span><span class="hero-orbit orbit-two" aria-hidden="true"></span>
          <span class="hero-watermark" aria-hidden="true">air.</span>
          <div class="hero-art-wrap"><img id="hero-image" src="<%= initialBanner.image %>" alt="<%= initialBanner.alt %>" fetchpriority="high" width="980" height="470" /></div>
          <div class="hero-product-note"><span class="note-plus" aria-hidden="true">+</span><span id="hero-note"><%= initialBanner.note %></span></div>
          <span class="hero-edition">THE MACPOINT EDIT / 01</span>
        </div>
        <div class="hero-bottom"><span class="hero-bottom-label">GOOD TECHNOLOGY. GREAT POSSIBILITIES.</span><div class="slider-controls"><span class="slide-number" id="slide-number">01 / <%= String(banners.length || 3).padStart(2, '0') %></span><div class="slider-dots" id="slider-dots"></div><button class="slider-arrow" id="hero-prev" aria-label="Previous collection">←</button><button class="slider-arrow" id="hero-next" aria-label="Next collection">→</button></div><a class="scroll-cue" href="#categories">Discover more <span aria-hidden="true">↓</span></a></div>
      </div>
    </section>
    <section class="service-strip" aria-label="Shopping with MacPoint"><div class="page-width service-inner">
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></svg>Thoughtfully selected</span>
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h12v12H3zM15 10h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>Delivery across Bangladesh</span>
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h4"/></svg>Cash on delivery</span>
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-1a8 8 0 0 1 16 0v1M4 12h3v7H4zM17 12h3v7h-3zM17 19c0 2-3 2-5 2"/></svg>Real people. Real support.</span>
    </div></section>
    <section class="category-section section-pad page-width" id="categories">
      <div class="section-heading reveal"><div><p class="eyebrow">FIND YOUR EVERYDAY</p><h2>A world of <span class="muted-heading">possibility.</span></h2></div><a class="text-link" href="/shop">Explore everything <span aria-hidden="true">↗</span></a></div>
      <div class="category-grid"><% categories.forEach(function(category, index) { %><a class="category-card reveal" href="/category/<%= category.slug %>"><span class="category-number">0<%= index + 1 %></span><span class="category-image"><img src="<%= category.image || products.find(p => p.category === category.name)?.image %>" alt="" loading="lazy" width="240" height="200" /></span><span class="category-title"><%= category.name === 'Watch' ? 'Apple Watch' : category.name %><span aria-hidden="true">↗</span></span><span class="category-subtitle"><%= category.description %></span></a><% }); %></div>
    </section>
    <section class="products-section section-pad page-width" id="products">
      <div class="section-heading reveal"><div><p class="eyebrow">CURATED, NOT COMPLICATED</p><h2>Great picks. <span class="muted-heading">Every day.</span></h2><p class="section-description">The devices you love. The little details that make them yours.</p></div><a class="text-link" href="/shop">Shop the collection <span aria-hidden="true">↗</span></a></div>
      <div class="collection-toolbar"><div class="product-filters" id="product-filters" aria-label="Filter products"><button class="filter-chip is-active" data-filter="All" aria-pressed="true">All essentials</button><% [...new Set(products.map(p => p.category))].forEach(function(category) { %><button class="filter-chip" data-filter="<%= category %>" aria-pressed="false"><%= category %></button><% }); %></div><div class="collection-sort"><span id="collection-count"><%= products.length %> essentials</span><label class="sr-only" for="merchandising-select">Collection</label><select id="merchandising-select"><option value="all">All essentials</option><option value="featured">Featured picks</option><option value="newArrival">New arrivals</option><option value="bestSeller">Best sellers</option></select></div></div>
      <div class="product-grid" id="product-grid" aria-live="polite"><% products.forEach(function(product, index) { %><%- include('partials/product-card', { product, index }) %><% }); %></div>
      <p class="empty-results" id="empty-results" hidden>No products here yet. Explore another collection.</p>
      <script id="catalog-data" type="application/json"><%- JSON.stringify(products).replace(/</g, '\\u003c') %></script><script id="banner-data" type="application/json"><%- JSON.stringify(banners.length ? banners : defaultBanners).replace(/</g, '\\u003c') %></script>
    </section>
    <section class="edit-grid page-width" aria-label="The everyday edit">
      <a class="edit-card edit-work reveal" href="/category/mac"><div><p class="eyebrow">THE WORK / LIFE EDIT</p><h2>Big ideas.<br />Meet your match.</h2><p>Make something you’re proud of.</p><span class="text-link">Find your Mac <span aria-hidden="true">↗</span></span></div><img src="/images/hero-macbook.png" alt="MacBook Air laptops" loading="lazy" width="980" height="470" /><span class="edit-watermark" aria-hidden="true">Create.</span></a>
      <a class="edit-card edit-audio reveal" href="/category/audio"><div><p class="eyebrow">YOUR DAILY SOUNDTRACK</p><h2>A little quiet.<br />A lot to love.</h2><p>Find a sound that feels like you.</p><span class="text-link">Explore audio <span aria-hidden="true">↗</span></span></div><img src="/images/airpods-pro.jpg" alt="AirPods Pro and charging case" loading="lazy" width="600" height="500" /></a>
    </section>
    <section class="difference-section section-pad page-width" id="benefits"><div class="section-heading reveal"><div><p class="eyebrow">THE MACPOINT DIFFERENCE</p><h2>Great tech.<br /><span class="muted-heading">An even better experience.</span></h2></div><p class="difference-intro">Because choosing your next device should feel as good as using it.</p></div><div class="difference-grid">
      <article class="difference-card reveal"><span class="difference-index">01 /</span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 11 4v9c0 7-11 13-11 13S5 23 5 16V7l11-4Z"/><path d="m11 15 4 4 7-8"/></svg><h3>Chosen with care.</h3><p>A considered collection of devices and essentials. Just the things we’d choose for ourselves.</p></article>
      <article class="difference-card reveal"><span class="difference-index">02 /</span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 7h22v15H15l-7 6v-6H5V7Z"/><path d="M10 12h12M10 17h7"/></svg><h3>People, not scripts.</h3><p>A quick question or a big decision? Talk to someone who will help you find your fit.</p><button class="text-link" data-open-support>Let’s talk <span aria-hidden="true">↗</span></button></article>
      <article class="difference-card reveal"><span class="difference-index">03 /</span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 12 6v15l-12 6L4 24V9l12-6ZM4 9l12 6 12-6M16 15v15M10 6l12 6v7"/></svg><h3>From us to you.</h3><p>Careful packing, delivery across Bangladesh, and cash on delivery. Clear from the start.</p><a class="text-link" href="/help">The finer details <span aria-hidden="true">↗</span></a></article>
    </div></section>
    <section class="newsletter-section"><div class="newsletter-inner page-width reveal"><div><p class="eyebrow">STAY IN THE KNOW</p><h2>A little ahead.<br />Always in the loop.</h2><p>Fresh arrivals, thoughtful finds, and the occasional good thing.</p></div><form class="newsletter-form" id="newsletter-form"><label class="sr-only" for="newsletter-email">Email address</label><input id="newsletter-email" type="email" placeholder="Your email address" autocomplete="email" required /><button class="button button-dark" type="submit">Count me in <span aria-hidden="true">↗</span></button><p class="form-message" id="newsletter-message" role="status"></p><span class="newsletter-note">Thoughtful finds. No noise.</span></form></div></section>
  </main>
  <%- include('partials/store-footer') %><%- include('partials/store-overlays') %>
</body></html>
