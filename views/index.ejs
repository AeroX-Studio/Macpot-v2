<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="<%= settings?.seoDescription || 'Discover Apple devices and everyday essentials at MacPoint Bangladesh.' %>" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css?v=2.2.0" />
    <link rel="stylesheet" href="/css/commerce.css?v=2.2.0" />
    <script src="/js/app.js?v=2.2.0" defer></script>
    <script src="/js/storefront.js?v=2.2.0" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <%- include('partials/store-header') %>

    <main id="main">
      <% const initialBanner = (banners && banners.length ? banners[0] : null) || {
        eyebrow: "MADE FOR WHAT’S NEXT",
        title: "A little more<br />wonder in every day.",
        description: "Meet the devices that make your big ideas, daily rituals, and everything in between feel effortless.",
        note: "MacBook Air · Built for the long run",
        image: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1400&q=88",
        alt: "A slim silver laptop on a bright desk"
      }; %>
      <section class="hero page-width" id="top" aria-label="Featured collection">
        <div class="hero-copy">
          <p class="eyebrow" id="hero-eyebrow"><%= initialBanner.eyebrow %></p>
          <h1 id="hero-title"><%- initialBanner.title.replace(/\n/g, '<br />') %></h1>
          <p class="hero-description" id="hero-description"><%= initialBanner.description %></p>
          <div class="hero-actions">
            <a class="button button-dark" href="#products" id="hero-cta">Explore the collection <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#categories">Find your device <span aria-hidden="true">↗</span></a>
          </div>
          <div class="slider-controls" aria-label="Featured slides">
            <button class="slider-arrow" id="hero-prev" aria-label="Previous slide"><span aria-hidden="true">←</span></button>
            <div class="slider-dots" id="slider-dots"></div>
            <button class="slider-arrow" id="hero-next" aria-label="Next slide"><span aria-hidden="true">→</span></button>
            <span class="slide-number" id="slide-number">01 / <%= String((banners && banners.length) || 3).padStart(2, '0') %></span>
          </div>
        </div>
        <div class="hero-visual" id="hero-visual">
          <div class="hero-art-wrap">
            <img id="hero-image" src="<%= initialBanner.image %>" alt="<%= initialBanner.alt || 'MacPoint featured product' %>" />
          </div>
          <div class="hero-product-note"><span class="note-line"></span><span id="hero-note"><%= initialBanner.note %></span></div>
          <div class="hero-index" aria-hidden="true">01</div>
        </div>
      </section>

      <section class="category-section section-pad page-width" id="categories">
        <div class="section-heading reveal">
          <div><p class="eyebrow">A WORLD OF POSSIBILITY</p><h2>What are you looking for?</h2></div>
          <a class="text-link" href="/shop">View all products <span aria-hidden="true">→</span></a>
        </div>
        <div class="category-grid">
          <% categories.forEach(function(category) { %>
            <a class="category-card reveal" href="/category/<%= category.slug %>">
              <span class="category-image">
                <img src="<%= category.image || products.find(function(product) { return product.category === category.name; })?.image || '' %>" alt="<%= category.name %>" loading="lazy" />
              </span>
              <span class="category-title"><%= category.name === 'Watch' ? 'Apple Watch' : category.name %></span>
              <span class="category-subtitle"><%= category.description %></span>
              <span class="category-arrow" aria-hidden="true">↗</span>
            </a>
          <% }); %>
        </div>
      </section>

      <section class="benefits-band" id="benefits">
        <div class="page-width benefits-grid">
          <div class="benefit reveal"><span class="benefit-icon" aria-hidden="true">01</span><div><h3>Advice that listens</h3><p>Real people, thoughtful recommendations.</p></div></div>
          <div class="benefit reveal"><span class="benefit-icon" aria-hidden="true">02</span><div><h3>Easy ways to pay</h3><p>Flexible options, clear from the start.</p></div></div>
          <div class="benefit reveal"><span class="benefit-icon" aria-hidden="true">03</span><div><h3>Here when you need us</h3><p>Care and support, before and after.</p></div></div>
          <div class="benefit reveal"><span class="benefit-icon" aria-hidden="true">04</span><div><h3>Delivered with care</h3><p>Careful packing, right to your door.</p></div></div>
        </div>
      </section>

      <section class="products-section section-pad page-width" id="products">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">THE ONES YOU LOVE</p>
            <h2>Customer favourites</h2>
            <p class="section-description">Thoughtfully chosen tech to help you do more of what you love.</p>
          </div>
          <div class="product-filters" id="product-filters" aria-label="Filter products">
            <button class="filter-chip is-active" data-filter="All" aria-pressed="true">All</button>
            <% const uniqueCategories = [...new Set(products.map(function(p) { return p.category; }).filter(Boolean))]; %>
            <% uniqueCategories.forEach(function(category) { %>
              <button class="filter-chip" data-filter="<%= category %>" aria-pressed="false"><%= category %></button>
            <% }); %>
          </div>
        </div>
        <div class="product-grid" id="product-grid" aria-live="polite">
          <% products.forEach(function(product, index) { %>
            <%- include('partials/product-card', { product: product, index: index }) %>
          <% }); %>
        </div>
        <script id="catalog-data" type="application/json"><%- JSON.stringify(products).replace(/</g, '\\u003c') %></script>
        <script id="banner-data" type="application/json"><%- JSON.stringify(banners).replace(/</g, '\\u003c') %></script>
        <p class="empty-results" id="empty-results" hidden>No products match that search. Try another name or category.</p>
      </section>

      <% if (newArrivals && newArrivals.length) { %>
      <section class="products-section section-pad page-width merch-section">
        <div class="section-heading">
          <div><p class="eyebrow">JUST ARRIVED</p><h2>New to the collection</h2></div>
          <a class="text-link" href="/shop?sort=newest">Explore all arrivals <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-grid">
          <% newArrivals.forEach(function(product, index) { %>
            <%- include('partials/product-card', { product: product, index: index }) %>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (bestSellers && bestSellers.length) { %>
      <section class="products-section section-pad page-width merch-section">
        <div class="section-heading">
          <div><p class="eyebrow">A LITTLE MORE LOVED</p><h2>MacPoint favourites</h2></div>
          <a class="text-link" href="/shop?sort=best_seller">Shop best sellers <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-grid">
          <% bestSellers.forEach(function(product, index) { %>
            <%- include('partials/product-card', { product: product, index: index }) %>
          <% }); %>
        </div>
      </section>
      <% } %>

      <section class="feature-banner page-width reveal">
        <div class="feature-copy">
          <p class="eyebrow">MEET YOUR NEXT BIG IDEA</p>
          <h2>Light on you.<br />Big on possibility.</h2>
          <p>Everything you need to take your day somewhere new, wrapped in a remarkably light design.</p>
          <a class="button button-light" href="/shop?category=Mac">Discover MacBook <span aria-hidden="true">→</span></a>
        </div>
        <div class="feature-image">
          <img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?auto=format&fit=crop&w=1300&q=88" alt="Open laptop ready for a new idea" loading="lazy" />
        </div>
        <span class="feature-serial" aria-hidden="true">MP — 001</span>
      </section>

      <section class="editorial-section section-pad page-width">
        <div class="editorial-mark reveal" aria-hidden="true">M.</div>
        <div class="editorial-copy reveal">
          <p class="eyebrow">THE MACPOINT WAY</p>
          <h2>Good technology should feel like it belongs to you.</h2>
          <p>We’re here to make choosing your next device feel clear, considered, and a little more personal. From first question to your next great idea, we’ll help you find the right fit.</p>
          <a class="text-link" href="/#footer">Get to know us <span aria-hidden="true">→</span></a>
        </div>
        <div class="editorial-image reveal">
          <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1000&q=85" alt="A calm, bright workspace" loading="lazy" />
        </div>
      </section>

      <section class="newsletter-section">
        <div class="newsletter-inner page-width reveal">
          <div>
            <p class="eyebrow">A NOTE FROM MACPOINT</p>
            <h2>Good things, occasionally.</h2>
            <p>New arrivals, useful ideas, and the occasional reason to smile. No noise.</p>
          </div>
          <form class="newsletter-form" id="newsletter-form">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input id="newsletter-email" type="email" placeholder="Your email address" required />
            <button class="button button-dark" type="submit">Sign me up <span aria-hidden="true">→</span></button>
            <p class="form-message" id="newsletter-message" role="status"></p>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/store-footer') %>
    <%- include('partials/store-overlays') %>
  </body>
</html>
