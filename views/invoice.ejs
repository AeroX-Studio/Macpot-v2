<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body class="invoice-body"><a class="skip-link" href="#invoice">Skip to invoice</a><main id="invoice" class="invoice-page">
  <div class="invoice-actions"><a class="text-link" href="<%= currentUser ? '/account' : '/' %>">← Back</a><button class="button button-dark" type="button" onclick="window.print()">Print / Save as PDF <span>↗</span></button></div>
  <article class="invoice-paper"><header class="invoice-header"><div><a class="brand" href="/"><span class="brand-mark">M<span>.</span></span><span class="brand-word">MACPOINT</span></a><p><%= snapshot.settings.address %><br /><%= snapshot.settings.supportEmail %><br /><%= snapshot.settings.hotline %></p></div><div class="invoice-title"><p class="eyebrow">CASH ON DELIVERY</p><h1>Invoice</h1><strong><%= invoice.invoiceNumber %></strong><span><%= new Date(snapshot.generatedAt).toLocaleDateString('en-BD') %></span></div></header>
  <div class="invoice-parties"><div><p class="eyebrow">BILL TO</p><strong><%= snapshot.order.shippingName %></strong><span><%= snapshot.order.shippingPhone %></span><span><%= snapshot.order.shippingAddress %></span><span><%= snapshot.order.shippingCity %></span></div><div><p class="eyebrow">ORDER</p><strong><%= snapshot.order.orderNumber %></strong><span><%= snapshot.order.shippingZone === 'dhaka' ? 'Inside Dhaka' : 'Outside Dhaka' %></span><span>Payment: Cash on delivery</span></div></div>
  <div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody><% snapshot.order.items.forEach(function(item) { %><tr><td><strong><%= item.productName %></strong><span class="table-subline"><%= item.variantName %><%= item.color ? ' · ' + item.color : '' %></span></td><td><%= item.sku %></td><td><%= item.quantity %></td><td>৳<%= formatPrice(item.price) %></td><td>৳<%= formatPrice(item.total) %></td></tr><% }); %></tbody></table></div>
  <div class="invoice-totals"><p><span>Subtotal</span><strong>৳<%= formatPrice(snapshot.order.subtotal) %></strong></p><% if (snapshot.order.couponCode) { %><p><span>Discount · <%= snapshot.order.couponCode %></span><strong>− ৳<%= formatPrice(snapshot.order.discount) %></strong></p><% } %><p><span>Delivery</span><strong>৳<%= formatPrice(snapshot.order.deliveryCharge) %></strong></p><p class="summary-total"><span>Amount due</span><strong>৳<%= formatPrice(snapshot.order.total) %></strong></p></div>
  <footer class="invoice-footer"><p>Thank you for choosing MacPoint.</p><span>Questions? <%= snapshot.settings.supportEmail || snapshot.settings.hotline || 'Contact our support team.' %></span></footer></article>
</main></body></html>
