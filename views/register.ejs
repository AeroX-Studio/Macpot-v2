<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body class="auth-body"><main class="auth-layout"><a class="brand" href="/"><span class="brand-mark">M<span>.</span></span><span class="brand-word">MACPOINT</span></a><section class="auth-card"><p class="eyebrow">YOUR NEXT STARTS HERE</p><h1>Create your account.</h1><p>Keep your orders and delivery details together.</p><% if (message) { %><p class="form-message form-error" role="alert"><%= message %></p><% } %><form method="post" action="/register"><label>Full name<input name="name" autocomplete="name" required /></label><label>Mobile number<input name="phone" type="tel" autocomplete="tel" placeholder="01XXXXXXXXX" required /></label><label>Email <span class="optional-label">Optional</span><input type="email" name="email" autocomplete="email" /></label><label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required /></label><button class="button button-dark" type="submit">Create account <span>→</span></button></form><p>Already have an account? <a href="/login">Sign in</a></p></section></main></body></html>
