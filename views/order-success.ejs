<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><%- include('partials/store-header') %><main id="main" class="page-width commerce-page order-success-page">
  <section class="order-success-card"><span class="success-mark">✓</span><p class="eyebrow">THANK YOU FOR CHOOSING MACPOINT</p><h1>Your order is in good hands.</h1><p>We’ve received your Cash on Delivery order <strong><%= order.orderNumber %></strong>. Our team will confirm the details with you.</p><a class="button button-dark" href="/order-success/<%= encodeURIComponent(order.orderNumber) %>/invoice?access=<%= encodeURIComponent(requestAccess || '') %>">View invoice <span>→</span></a><a class="text-link" href="/shop">Continue exploring</a></section>
  <section class="order-tracker"><p class="eyebrow">YOUR ORDER JOURNEY</p><h2>We’ll keep you in the loop.</h2><ol class="fulfillment-stepper"><% ['pending','confirmed','processing','packed','shipped','out_for_delivery','delivered'].forEach(function(status, index) { %><li class="<%= order.orderStatus === status ? 'is-current' : (order.timeline.some(function(item) { return item.status === status; }) ? 'is-complete' : '') %>"><span><%= index + 1 %></span><strong><%= statusLabel(status) %></strong></li><% }); %></ol>
    <div class="order-summary-card"><div><p class="eyebrow">ORDER SUMMARY</p><strong><%= order.items.length %> <%= order.items.length === 1 ? 'item' : 'items' %></strong></div><strong>৳<%= formatPrice(order.total) %></strong><p>Cash on delivery · <%= order.shippingZone === 'dhaka' ? 'Inside Dhaka' : 'Outside Dhaka' %></p></div>
  </section>
  <% if (canClaimAccount) { %><form class="form-card order-claim-form" method="post" action="/order-success/<%= encodeURIComponent(order.orderNumber) %>/claim-account"><% if (notice) { %><p class="form-message <%= notice.kind === 'error' ? 'form-error' : '' %>" role="status"><%= notice.message %></p><% } %><p class="eyebrow">YOUR ACCOUNT IS READY</p><h2>Keep your order history together.</h2><p>Choose a password to sign in with your mobile number and follow future orders here.</p><input type="hidden" name="access" value="<%= requestAccess %>" /><div class="form-grid"><label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required /></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required /></label></div><button class="button button-dark" type="submit">Set password and open account <span>→</span></button></form><% } %>
</main><%- include('partials/store-footer') %><%- include('partials/store-overlays') %><script src="/js/app.js?v=2.2.0" defer></script></body></html>
