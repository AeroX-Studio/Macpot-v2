<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /><script src="/js/admin.js?v=2.2.0" defer></script></head>
<body class="admin-body">
<header class="admin-topbar"><a class="brand" href="/"><span class="brand-mark">M<span>.</span></span><span class="brand-word">MACPOINT</span></a><div><span><%= currentUser.name %> · <%= currentUser.role %></span><a href="/">View storefront</a><form action="/logout" method="post"><button type="submit">Sign out</button></form></div></header>
<div class="admin-layout"><aside class="admin-sidebar"><p class="eyebrow">STORE OPERATIONS</p>
  <a class="<%= section === 'dashboard' ? 'is-active' : '' %>" href="/admin">Overview</a>
  <% if (canAdmin('orders')) { %><a class="<%= section === 'orders' || section === 'order-detail' ? 'is-active' : '' %>" href="/admin/orders">Orders</a><% } %>
  <% if (canAdmin('products')) { %><a class="<%= section === 'products' ? 'is-active' : '' %>" href="/admin/products">Products</a><% } %>
  <% if (canAdmin('categories')) { %><a class="<%= section === 'categories' ? 'is-active' : '' %>" href="/admin/categories">Categories</a><% } %>
  <% if (canAdmin('banners')) { %><a class="<%= section === 'banners' ? 'is-active' : '' %>" href="/admin/banners">Homepage banners</a><% } %>
  <% if (canAdmin('inventory')) { %><a class="<%= section === 'inventory' ? 'is-active' : '' %>" href="/admin/inventory">Inventory</a><% } %>
  <% if (canAdmin('customers')) { %><a class="<%= section === 'customers' ? 'is-active' : '' %>" href="/admin/customers">Customers</a><% } %>
  <% if (canAdmin('coupons')) { %><a class="<%= section === 'coupons' ? 'is-active' : '' %>" href="/admin/coupons">Coupons</a><% } %>
  <% if (canAdmin('chat')) { %><a class="<%= section === 'chat' ? 'is-active' : '' %>" href="/admin/chat">Support chat <span class="nav-count"><%= data.conversations.reduce(function(sum, item) { return sum + Number(item.unreadAdmin || 0); }, 0) || '' %></span></a><% } %>
  <% if (canAdmin('settings')) { %><a class="<%= section === 'settings' ? 'is-active' : '' %>" href="/admin/settings">Store settings</a><% } %><% if (canAdmin('users')) { %><a class="<%= section === 'users' ? 'is-active' : '' %>" href="/admin/users">Admin access</a><% } %>
  <div class="admin-sidebar-foot"><p class="eyebrow">MACPOINT</p><span><%= data.settings.storeName %> control center</span><small style="display:block;margin-top:5px;font-size:9px;color:rgba(255,255,255,0.45);letter-spacing:0.04em;">Made by <strong style="color:rgba(255,255,255,0.85);font-weight:700;">AeroX</strong></small></div>
</aside>
<main class="admin-main">
  <% if (notice) { %><div class="admin-notice <%= notice.kind === 'error' ? 'is-error' : '' %>" role="status"><%= notice.message %></div><% } %>
  <% if (section === 'dashboard') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">AT A GLANCE</p><h1>Good to see you, <%= currentUser.name.split(' ')[0] %>.</h1><p>Here’s how your store is doing right now.</p></div><a class="button button-dark" href="/admin/orders?status=pending">Review pending orders <span>→</span></a></div>
    <div class="admin-metrics"><article><span>Total COD revenue</span><strong>৳<%= formatPrice(metrics.revenue) %></strong><small>Orders not cancelled</small></article><article><span>Orders</span><strong><%= metrics.orders %></strong><small><%= metrics.pending %> awaiting confirmation</small></article><article><span>Active catalog</span><strong><%= metrics.products %></strong><small><%= metrics.lowStock %> low stock</small></article><article><span>Customers</span><strong><%= metrics.customers %></strong><small>Registered accounts</small></article></div>
    <div class="admin-dashboard-grid"><section class="admin-card"><div class="content-heading"><div><p class="eyebrow">THE LATEST</p><h2>Recent orders</h2></div><a class="text-link" href="/admin/orders">All orders <span>→</span></a></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Area</th><th>Total</th><th>Status</th></tr></thead><tbody><% recentOrders.forEach(function(order) { %><tr><td><a class="text-link" href="/admin/orders/<%= order.id %>"><%= order.orderNumber %></a></td><td><%= order.shippingName %><small class="table-subline"><%= order.shippingPhone %></small></td><td><%= order.shippingZone === 'dhaka' ? 'Dhaka' : 'Outside Dhaka' %></td><td>৳<%= formatPrice(order.total) %></td><td><span class="status-pill"><%= statusLabel(order.orderStatus) %></span></td></tr><% }); %></tbody></table><% if (!recentOrders.length) { %><p class="admin-empty">Orders will appear here after checkout is enabled for customers.</p><% } %></div></section>
      <section class="admin-card"><div class="content-heading"><div><p class="eyebrow">MOVING WELL</p><h2>Top products</h2></div><a class="text-link" href="/admin/products">Manage catalog</a></div><ol class="top-product-list"><% topProducts.forEach(function(product, index) { %><li><span class="rank-number"><%= String(index + 1).padStart(2, '0') %></span><span><strong><%= product.name %></strong><small><%= product.totalSold %> sold · <%= product.stock %> in stock</small></span><span>৳<%= formatPrice(product.price) %></span></li><% }); %></ol></section></div>
    <section class="admin-card notification-feed"><div class="content-heading"><div><p class="eyebrow">STORE ACTIVITY</p><h2>Recent notifications</h2></div></div><% if (notifications.length) { %><ul><% notifications.forEach(function(item) { %><li><a href="<%= item.orderId ? '/admin/orders/' + item.orderId : '/admin' %>"><span class="status-pill"><%= item.read ? 'Read' : 'New' %></span><strong><%= item.text %></strong><time><%= new Date(item.createdAt).toLocaleString('en-BD') %></time></a></li><% }); %></ul><% } else { %><p class="admin-empty">New order notifications will appear here.</p><% } %></section>
  <% } else if (section === 'orders') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">FULFILLMENT</p><h1>Orders</h1><p>Confirm each order, keep the customer updated, and track COD settlement.</p></div></div>
    <nav class="order-status-tabs"><% ['all',...statuses].forEach(function(status) { %><a class="<%= (queryStatus || 'all') === status ? 'is-active' : '' %>" href="/admin/orders?status=<%= status %>"><%= status === 'all' ? 'All orders' : statusLabel(status) %><span><%= counts[status] %></span></a><% }); %></nav>
    <form class="admin-search" action="/admin/orders"><input type="hidden" name="status" value="<%= queryStatus || 'all' %>" /><input type="search" name="q" value="<%= search || '' %>" placeholder="Search order, customer, or phone" /><button class="button button-dark">Search <span>→</span></button></form>
    <section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Verification</th><th>Delivery</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(function(order) { const waPhone = (order.shippingPhone || '').replace(/\D/g, '').replace(/^0/, '880'); %><tr><td><strong><%= order.orderNumber %></strong><small class="table-subline"><%= new Date(order.createdAt).toLocaleString('en-BD') %></small></td><td><%= order.shippingName %><small class="table-subline"><%= order.shippingPhone %></small></td><td><div class="admin-verify-bridge" style="display:inline-flex;gap:5px;align-items:center;"><a class="button button-light" href="tel:<%= order.shippingPhone %>" style="min-height:26px;padding:0 7px;font-size:9px;" title="Direct phone dial">📞 Call</a><a class="button button-light" href="https://wa.me/<%= waPhone %>?text=<%= encodeURIComponent('Hello ' + order.shippingName + '! This is MacPoint regarding your Cash on Delivery order #' + order.orderNumber + '.') %>" target="_blank" rel="noopener noreferrer" style="min-height:26px;padding:0 7px;font-size:9px;color:#128c7e;" title="WhatsApp verification bridge">💬 WhatsApp <span>↗</span></a></div></td><td><%= order.shippingZone === 'dhaka' ? 'Dhaka' : 'Outside Dhaka' %></td><td>৳<%= formatPrice(order.total) %></td><td><span class="status-pill"><%= order.paymentStatus.replaceAll('_',' ') %></span></td><td><span class="status-pill"><%= statusLabel(order.orderStatus) %></span></td><td><a class="text-link" href="/admin/orders/<%= order.id %>">Open</a></td></tr><% }); %></tbody></table></div><% if (!orders.length) { %><p class="admin-empty">No orders match this view.</p><% } %></section>
  <% } else if (section === 'order-detail') { %>
    <div class="admin-page-heading"><div><p class="eyebrow"><a href="/admin/orders">ORDERS</a> · FULFILLMENT</p><h1><%= order.orderNumber %></h1><p>Placed <%= new Date(order.createdAt).toLocaleString('en-BD') %></p></div><a class="button button-light" href="/admin/orders/<%= order.id %>/invoice">Invoice <span>↗</span></a></div>
    <div class="order-detail-grid"><section class="admin-card"><p class="eyebrow">ITEMS & TOTAL</p><% order.items.forEach(function(item) { %><article class="order-line"><img src="<%= item.image %>" alt="" /><div><strong><%= item.productName %></strong><span><%= item.variantName %><%= item.color ? ' · ' + item.color : '' %> · Qty <%= item.quantity %></span></div><strong>৳<%= formatPrice(item.total) %></strong></article><% }); %><div class="summary-lines"><p><span>Subtotal</span><strong>৳<%= formatPrice(order.subtotal) %></strong></p><p><span>Discount <%= order.couponCode ? '· ' + order.couponCode : '' %></span><strong>− ৳<%= formatPrice(order.discount) %></strong></p><p><span>Delivery</span><strong>৳<%= formatPrice(order.deliveryCharge) %></strong></p><p class="summary-total"><span>Total</span><strong>৳<%= formatPrice(order.total) %></strong></p></div></section>
      <section class="admin-card"><p class="eyebrow">CUSTOMER & DELIVERY</p><h2><%= order.shippingName %></h2><p><%= order.shippingPhone %><br /><%= order.shippingAddress %><br /><%= order.shippingCity %> · <%= order.shippingZone === 'dhaka' ? 'Inside Dhaka' : 'Outside Dhaka' %></p><% const waDetail = (order.shippingPhone || '').replace(/\D/g, '').replace(/^0/, '880'); %><div class="contact-actions" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;"><a class="button button-light" href="tel:<%= order.shippingPhone %>">📞 Direct Phone Dial: <%= order.shippingPhone %> <span>↗</span></a><a class="button button-dark" href="https://wa.me/<%= waDetail %>?text=<%= encodeURIComponent('Hello ' + order.shippingName + '! This is MacPoint regarding your Cash on Delivery order #' + order.orderNumber + '.') %>" target="_blank" rel="noopener noreferrer" style="background:#25d366;border-color:#25d366;color:#ffffff;">💬 WhatsApp Verification Bridge <span>↗</span></a></div><% if (order.notes) { %><p class="eyebrow">DELIVERY NOTES</p><p><%= order.notes %></p><% } %>
      <form class="status-update-form" method="post" action="/admin/orders/<%= order.id %>/status"><p class="eyebrow">UPDATE ORDER</p><label>Fulfillment status<select name="orderStatus"><% statuses.forEach(function(status) { %><option value="<%= status %>" <%= order.orderStatus === status ? 'selected' : '' %>><%= statusLabel(status) %></option><% }); %></select></label><label>COD payment<select name="paymentStatus"><% payments.forEach(function(status) { %><option value="<%= status %>" <%= order.paymentStatus === status ? 'selected' : '' %>><%= status.replaceAll('_',' ') %></option><% }); %></select></label><label>Timeline note<textarea name="note" rows="2" placeholder="Optional update for the customer timeline"></textarea></label><button class="button button-dark">Save update <span>→</span></button></form>
      </section></div><section class="admin-card"><p class="eyebrow">ORDER TIMELINE</p><ol class="timeline-list"><% order.timeline.slice().reverse().forEach(function(event) { %><li><span><%= statusLabel(event.status) %></span><time><%= new Date(event.createdAt).toLocaleString('en-BD') %></time><p><%= event.note %></p></li><% }); %></ol></section>
  <% } else if (section === 'products') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">CATALOG</p><h1>Products</h1><p>Images, configurations, stock, and homepage merchandising.</p></div><a class="button button-dark" href="/admin/products#product-editor">Add a product <span>+</span></a></div>
    <section class="admin-card" id="product-editor"><p class="eyebrow">PRODUCT EDITOR</p><h2><%= editProduct ? 'Edit ' + editProduct.name : 'Add a product' %></h2><form class="admin-form-grid" method="post" action="/admin/products/save" id="product-editor-form"><input type="hidden" name="id" value="<%= editProduct?.id || '' %>" /><input type="hidden" name="active" value="<%= editProduct?.active === false ? 'off' : 'on' %>" /><label>Name<input name="name" value="<%= editProduct?.name || '' %>" required /></label><label>Category<select name="categoryId" required><% categories.forEach(function(category) { %><option value="<%= category.id %>" <%= editProduct?.category === category.name ? 'selected' : '' %>><%= category.name %></option><% }); %></select></label><label>SKU<input name="sku" value="<%= editProduct?.sku || '' %>" /></label><label>Regular price (৳)<input type="number" min="1" name="price" value="<%= editProduct?.price || '' %>" required /></label><label>Sale price (৳)<input type="number" min="0" name="salePrice" value="<%= editProduct?.salePrice || '' %>" /></label><label>Low stock alert at<input type="number" min="0" name="lowStockThreshold" value="<%= editProduct?.lowStockThreshold ?? 4 %>" /></label><label class="field-wide">Short description<textarea name="description" rows="2"><%= editProduct?.description || '' %></textarea></label><label class="field-wide">Tags, separated by commas<input name="tags" value="<%= editProduct?.tags?.join(', ') || '' %>" /></label>
      <div class="field-wide upload-area"><label>Product images<input type="file" id="product-image-upload" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml" multiple /></label><div id="product-image-previews"><% (editProduct?.images || []).forEach(function(image) { %><img src="<%= image.url %>" alt="" /><input type="hidden" name="images" value="<%= image.url %>" /><% }); %></div><p class="form-help">JPEG, PNG, WebP, GIF, SVG, or AVIF · 5 MB per image.</p></div>
      <div class="field-wide"><div class="content-heading"><div><p class="eyebrow">CONFIGURATIONS</p><span>Add storage and colour options with their own price and stock.</span></div><button class="button button-light" type="button" data-add-variant>Add option <span>+</span></button></div><div class="variant-presets"><span>Start with a preset:</span><button type="button" data-variant-preset="mac">Mac storage</button><button type="button" data-variant-preset="iphone">iPhone storage</button><button type="button" data-variant-preset="watch">Watch sizes</button><button type="button" data-variant-preset="clothing">Standard clothing (S–XXL)</button><button type="button" data-variant-preset="numeric">Numeric sizing (38–52)</button><button type="button" data-variant-preset="free">Free size</button><button type="button" data-variant-preset="standard">Standard</button></div><div class="variant-editor" id="variant-editor"><% (editProduct?.variants || []).forEach(function(variant) { %><div class="variant-edit-row"><input type="hidden" name="variantId" value="<%= variant.id %>" /><label>Option<input name="variantName" value="<%= variant.name %>" required /></label><label>Colour<input name="variantColor" value="<%= variant.color || '' %>" /></label><label>Price override<input type="number" name="variantPrice" value="<%= variant.price || '' %>" /></label><label>Stock<input type="number" min="0" name="variantStock" value="<%= variant.stock %>" /></label><button type="button" class="remove-variant" aria-label="Remove option">×</button></div><% }); %></div></div>
      <div class="field-wide flag-row"><label class="check-field"><input type="checkbox" name="active" <%= !editProduct || editProduct.active ? 'checked' : '' %> /> Active</label><label class="check-field"><input type="checkbox" name="featured" <%= editProduct?.featured ? 'checked' : '' %> /> Featured</label><label class="check-field"><input type="checkbox" name="newArrival" <%= editProduct?.newArrival ? 'checked' : '' %> /> New arrival</label><label class="check-field"><input type="checkbox" name="bestSeller" <%= editProduct?.bestSeller ? 'checked' : '' %> /> Best seller</label></div><div class="field-wide"><button class="button button-dark">Save product <span>→</span></button></div>
    </form></section>
    <section class="admin-card"><div class="content-heading"><div><p class="eyebrow">THE COLLECTION</p><h2>All products</h2></div></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Configurations</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach(function(product) { %><tr><td><strong><%= product.name %></strong><small class="table-subline"><%= product.sku %></small></td><td><%= product.category %></td><td><%= product.variants.length %></td><td>৳<%= formatPrice(product.salePrice || product.price) %></td><td><%= product.stock %></td><td><%= product.active ? 'Active' : 'Archived' %></td><td><a class="text-link" href="/admin/products?edit=<%= product.id %>#product-editor">Edit</a><form method="post" action="/admin/products/<%= product.id %>/delete"><button class="text-link" type="submit"><%= product.active ? 'Archive' : 'Remove' %></button></form></td></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'categories') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">NAVIGATION & MERCHANDISING</p><h1>Categories</h1><p>Choose which collections appear in navigation and on the homepage.</p></div></div>
    <section class="admin-card"><p class="eyebrow"><%= editCategory ? 'EDIT CATEGORY' : 'ADD A CATEGORY' %></p><form class="admin-form-grid" method="post" action="/admin/categories/save"><input type="hidden" name="id" value="<%= editCategory?.id %>" /><label>Name<input name="name" value="<%= editCategory?.name || '' %>" required /></label><label>Slug<input name="slug" value="<%= editCategory?.slug || '' %>" /></label><label>Display order<input type="number" name="sortOrder" value="<%= editCategory?.sortOrder ?? 0 %>" /></label><label>Image URL<input name="image" value="<%= editCategory?.image || '' %>" /></label><label class="field-wide">Description<textarea name="description" rows="2"><%= editCategory?.description || '' %></textarea></label><div class="field-wide flag-row"><label class="check-field"><input type="checkbox" name="showInSidebar" <% if (!editCategory || editCategory.showInSidebar) { %>checked<% } %> /> Shop filters</label><label class="check-field"><input type="checkbox" name="showInHeader" <% if (!editCategory || editCategory.showInHeader) { %>checked<% } %> /> Header navigation</label><label class="check-field"><input type="checkbox" name="showOnHomepage" <% if (!editCategory || editCategory.showOnHomepage) { %>checked<% } %> /> Homepage</label><label class="check-field"><input type="checkbox" name="active" <% if (!editCategory || editCategory.active) { %>checked<% } %> /> Active</label></div><div class="field-wide"><button class="button button-dark">Save category <span>→</span></button></div></form></section>
    <section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Collection</th><th>Products</th><th>Shop filters</th><th>Header</th><th>Homepage</th><th>Active</th></tr></thead><tbody><% categories.forEach(function(category) { %><tr><td><a class="text-link" href="/admin/categories?edit=<%= category.id %>"><strong><%= category.name %></strong></a><small class="table-subline">/<%= category.slug %></small></td><td><%= data.products.filter(function(product) { return product.category === category.name && product.active; }).length %></td><% [['showInSidebar','Sidebar'],['showInHeader','Header'],['showOnHomepage','Homepage'],['active','Active']].forEach(function(pair) { %><td><form method="post" action="/admin/categories/<%= category.id %>/toggle"><input type="hidden" name="key" value="<%= pair[0] %>" /><button class="toggle-button <%= category[pair[0]] ? 'is-on' : '' %>" aria-label="Toggle <%= pair[1] %> for <%= category.name %>"><%= category[pair[0]] ? 'On' : 'Off' %></button></form></td><% }); %></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'inventory') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">WAREHOUSE</p><h1>Inventory</h1><p>Adjust stock by configuration. Every change is recorded in the inventory log.</p></div><a class="button button-light" href="/admin/inventory?low=<%= lowOnly ? '0' : '1' %>"><%= lowOnly ? 'Show all stock' : 'Show low stock' %> <span>↗</span></a></div>
    <section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Option</th><th>Stock</th><th>Adjust</th><th>Low threshold</th></tr></thead><tbody><% products.forEach(function(product) { product.variants.filter(function(variant) { return variant.active && (!lowOnly || variant.stock <= product.lowStockThreshold); }).forEach(function(variant) { %><tr><td><strong><%= product.name %></strong></td><td><%= variant.sku || product.sku %></td><td><%= variant.name %><%= variant.color ? ' · ' + variant.color : '' %></td><td class="tabular-nums"><%= variant.stock %></td><td><form class="stock-adjust-form" method="post" action="/admin/inventory/adjust"><input type="hidden" name="productId" value="<%= product.id %>" /><input type="hidden" name="variantId" value="<%= variant.id %>" /><button name="delta" value="-1" aria-label="Remove one from <%= product.name %> <%= variant.name %>">−</button><button name="delta" value="1" aria-label="Add one to <%= product.name %> <%= variant.name %>">+</button></form></td><td><%= product.lowStockThreshold %></td></tr><% }); }); %></tbody></table></div></section>
    <section class="admin-card"><p class="eyebrow">RECENT CHANGES</p><h2>Inventory log</h2><div class="table-wrap"><table><thead><tr><th>When</th><th>Product / option</th><th>Change</th><th>Previous</th><th>New</th><th>Reason</th></tr></thead><tbody><% logs.forEach(function(log) { const product = data.products.find(function(item) { return item.id === log.productId; }); const variant = product?.variants.find(function(item) { return item.id === log.variantId; }); %><tr><td><%= new Date(log.createdAt).toLocaleString('en-BD') %></td><td><%= product?.name || 'Archived item' %> · <%= variant?.name || 'Option' %></td><td><%= log.adjustment > 0 ? '+' : '' %><%= log.adjustment %></td><td><%= log.previousStock %></td><td><%= log.newStock %></td><td><%= log.reason %></td></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'customers') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">CUSTOMER RELATIONSHIPS</p><h1>Customers</h1><p>Order history and lifetime COD spend by customer.</p></div></div><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Phone</th><th>Email</th><th>Orders</th><th>Total spend</th><th>Joined</th></tr></thead><tbody><% customers.forEach(function(customer) { %><tr><td><strong><%= customer.name %></strong></td><td><a class="text-link" href="tel:<%= customer.phone %>"><%= customer.phone %></a></td><td><%= customer.email || '—' %></td><td><%= customer.orderCount %></td><td>৳<%= formatPrice(customer.totalSpent) %></td><td><%= new Date(customer.createdAt).toLocaleDateString('en-BD') %></td></tr><% }); %></tbody></table></div><% if (!customers.length) { %><p class="admin-empty">Customers appear here when they register or place an order.</p><% } %></section>
  <% } else if (section === 'banners') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">HOMEPAGE MERCHANDISING</p><h1>Hero banners</h1><p>Manage the images and messages in the existing homepage slider.</p></div></div><section class="admin-card"><p class="eyebrow"><%= editBanner ? 'EDIT BANNER' : 'ADD A BANNER' %></p><form class="admin-form-grid" method="post" action="/admin/banners/save"><input type="hidden" name="id" value="<%= editBanner?.id || '' %>" /><label>Eyebrow<input name="eyebrow" value="<%= editBanner?.eyebrow || '' %>" /></label><label>Sort order<input type="number" name="sortOrder" value="<%= editBanner?.sortOrder ?? banners.length %>" /></label><label class="field-wide">Headline<textarea name="title" rows="2" required><%= editBanner?.title || '' %></textarea></label><label class="field-wide">Description<textarea name="description" rows="2"><%= editBanner?.description || '' %></textarea></label><label>Product note<input name="note" value="<%= editBanner?.note || '' %>" /></label><label>Image alt text<input name="alt" value="<%= editBanner?.alt || '' %>" /></label><label class="field-wide">Image URL<input name="image" value="<%= editBanner?.image || '' %>" required /></label><label class="check-field"><input type="checkbox" name="active" <%= editBanner?.active === false ? '' : 'checked' %> /> Active</label><div class="field-wide flag-row"><button class="button button-dark">Save banner <span>→</span></button><a class="text-link" href="/admin/banners">Clear form</a></div></form></section><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Banner</th><th>Order</th><th>Status</th><th></th></tr></thead><tbody><% banners.slice().sort(function(a,b) { return a.sortOrder - b.sortOrder; }).forEach(function(banner) { %><tr><td><strong><%= banner.title.replace(/\n/g, ' / ') %></strong><small class="table-subline"><%= banner.eyebrow %></small></td><td><%= banner.sortOrder %></td><td><form method="post" action="/admin/banners/<%= banner.id %>/toggle"><button class="toggle-button <%= banner.active ? 'is-on' : '' %>"><%= banner.active ? 'Active' : 'Paused' %></button></form></td><td><a class="text-link" href="/admin/banners?edit=<%= banner.id %>">Edit</a></td></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'coupons') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">PROMOTIONS</p><h1>Coupons</h1><p>Set discount value, minimum basket, usage, and expiry.</p></div></div><section class="admin-card"><p class="eyebrow"><%= editCoupon ? 'EDIT COUPON' : 'CREATE A CODE' %></p><form class="admin-form-grid" method="post" action="/admin/coupons/save"><input type="hidden" name="id" value="<%= editCoupon?.id || '' %>" /><label>Code<input name="code" value="<%= editCoupon?.code || '' %>" required maxlength="32" /></label><label>Discount type<select name="type"><option value="percentage" <%= editCoupon?.type === 'percentage' ? 'selected' : '' %>>Percentage</option><option value="fixed" <%= editCoupon?.type === 'fixed' ? 'selected' : '' %>>Fixed BDT amount</option></select></label><label>Discount value<input type="number" min="1" name="value" value="<%= editCoupon?.value || '' %>" required /></label><label>Minimum order (৳)<input type="number" min="0" name="minOrderAmount" value="<%= editCoupon?.minOrderAmount ?? 0 %>" /></label><label>Maximum discount (৳)<input type="number" min="0" name="maxDiscount" value="<%= editCoupon?.maxDiscount ?? 0 %>" /></label><label>Usage limit<input type="number" min="0" name="usageLimit" value="<%= editCoupon?.usageLimit ?? 0 %>" /></label><label>Expiry date<input type="date" name="expiryDate" value="<%= editCoupon?.expiryDate || '' %>" /></label><label class="check-field"><input type="checkbox" name="active" <%= editCoupon?.active === false ? '' : 'checked' %> /> Active</label><div class="field-wide flag-row"><button class="button button-dark">Save coupon <span>→</span></button><a class="text-link" href="/admin/coupons">Clear form</a></div></form></section><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Code</th><th>Discount</th><th>Minimum</th><th>Redeemed</th><th>Expires</th><th>Status</th></tr></thead><tbody><% coupons.forEach(function(coupon) { %><tr><td><a class="text-link" href="/admin/coupons?edit=<%= coupon.id %>"><strong><%= coupon.code %></strong></a></td><td><%= coupon.type === 'percentage' ? coupon.value + '%' : '৳' + formatPrice(coupon.value) %></td><td>৳<%= formatPrice(coupon.minOrderAmount) %></td><td><%= coupon.usedCount %><%= coupon.usageLimit ? ' / ' + coupon.usageLimit : '' %></td><td><%= coupon.expiryDate || 'No expiry' %></td><td><form method="post" action="/admin/coupons/<%= coupon.id %>/toggle"><button class="toggle-button <%= coupon.active ? 'is-on' : '' %>"><%= coupon.active ? 'Active' : 'Paused' %></button></form></td></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'settings') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">STORE PROFILE</p><h1>Settings</h1><p>Keep your contact details, delivery rates, and store metadata up to date.</p></div></div><section class="admin-card"><form class="admin-form-grid" method="post" action="/admin/settings/save"><% [['storeName','Store name'],['tagline','Tagline'],['hotline','Hotline phone'],['complaintsPhone','Complaints phone'],['supportEmail','Support email'],['address','Physical address'],['logoUrl','Logo URL'],['faviconUrl','Favicon URL'],['whatsapp','WhatsApp number'],['seoTitle','SEO title'],['seoDescription','SEO description']].forEach(function(pair) { %><label><%= pair[1] %><input name="<%= pair[0] %>" value="<%= settings[pair[0]] || '' %>" /></label><% }); %><label>Inside Dhaka delivery (৳)<input type="number" min="0" name="deliveryDhaka" value="<%= settings.deliveryDhaka %>" /></label><label>Outside Dhaka delivery (৳)<input type="number" min="0" name="deliveryOutsideDhaka" value="<%= settings.deliveryOutsideDhaka %>" /></label><label>Free delivery threshold (৳)<input type="number" min="0" name="freeDeliveryThreshold" value="<%= settings.freeDeliveryThreshold %>" /></label><div class="field-wide"><button class="button button-dark">Save settings <span>→</span></button></div></form></section>
  <% } else if (section === 'users') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">ACCESS CONTROL</p><h1>Admin access</h1><p>Assign operational roles to the people who run the store.</p></div></div><section class="admin-card"><p class="eyebrow">ADD AN ADMINISTRATOR</p><form class="admin-form-grid" method="post" action="/admin/users/save"><label>Name<input name="name" required /></label><label>Email<input type="email" name="email" required /></label><label>Role<select name="role"><% Object.keys(rolePermissions).filter(function(role) { return currentUser.role === 'Super Admin' || role !== 'Super Admin'; }).forEach(function(role) { %><option value="<%= role %>"><%= role %></option><% }); %></select></label><label>Temporary password<input type="password" name="password" minlength="12" required /></label><div class="field-wide"><button class="button button-dark">Create admin <span>+</span></button></div></form></section><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Administrator</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead><tbody><% users.forEach(function(user) { %><tr><td><strong><%= user.name %></strong></td><td><%= user.email %></td><td><%= user.role %></td><td><%= new Date(user.createdAt).toLocaleDateString('en-BD') %></td></tr><% }); %></tbody></table></div></section>
  <% } else if (section === 'chat') { %>
    <div class="admin-page-heading"><div><p class="eyebrow">CUSTOMER CARE</p><h1>Support desk</h1><p>Conversations refresh while this page is open.</p></div></div><div class="support-workstation">
      <aside class="support-conversations"><p class="eyebrow">CONVERSATIONS</p><% conversations.forEach(function(conversation) { %><a class="conversation-link <%= activeConversation?.id === conversation.id ? 'is-active' : '' %>" href="/admin/chat?id=<%= conversation.id %>"><span class="online-indicator <%= Date.now() - new Date(conversation.customerOnlineAt).getTime() < 120000 ? 'is-online' : '' %>"></span><span><strong><%= conversation.name %></strong><small><%= conversation.lastMessage || 'Started a conversation' %></small></span><% if (conversation.unreadAdmin) { %><b><%= conversation.unreadAdmin %></b><% } %></a><% }); %><% if (!conversations.length) { %><p class="admin-empty">New conversations will appear here.</p><% } %></aside>
      <section class="support-messages" data-conversation-id="<%= activeConversation?.id || '' %>" id="admin-chat"><% if (activeConversation) { %><div class="support-chat-head"><div><p class="eyebrow">LIVE CUSTOMER CONVERSATION</p><h2><%= activeConversation.name %></h2></div><a class="button button-light" href="https://wa.me/<%= activeConversation.phone.replace(/\D/g,'') %>" target="_blank" rel="noopener noreferrer">WhatsApp <span>↗</span></a></div><div class="support-chat-stream" id="admin-chat-stream"><% messages.forEach(function(message) { %><article class="chat-message <%= message.senderType === 'admin' ? 'from-admin' : 'from-customer' %>"><strong><%= message.senderType === 'admin' ? 'MacPoint team' : activeConversation.name %></strong><p><%= message.message %></p><time><%= new Date(message.createdAt).toLocaleTimeString('en-BD') %></time></article><% }); %></div><div class="quick-replies"><button type="button" data-reply="We’re checking that configuration for you now.">Checking availability</button><button type="button" data-reply="Delivery usually takes 1–3 business days inside Dhaka.">Delivery timing</button><button type="button" data-reply="Cash on delivery is available across Bangladesh.">COD payment</button></div><form id="admin-chat-form" class="chat-compose"><input name="message" maxlength="2000" placeholder="Reply to this customer…" required /><button class="button button-dark">Send <span>→</span></button></form><% } else { %><div class="empty-state"><h2>No open conversations yet.</h2><p>Customer questions will show up here.</p></div><% } %></section>
      <aside class="support-context"><p class="eyebrow">CUSTOMER CONTEXT</p><% if (activeConversation) { %><h2><%= activeConversation.name %></h2><a class="text-link" href="tel:<%= activeConversation.phone %>"><%= activeConversation.phone %></a><p>Joined <%= new Date(activeConversation.createdAt).toLocaleDateString('en-BD') %></p><p><strong><%= customerOrders.length %></strong> orders · <strong>৳<%= formatPrice(customerOrders.reduce(function(sum, order) { return sum + order.total; }, 0)) %></strong> lifetime</p><% customerOrders.slice(0,5).forEach(function(order) { %><a class="context-order" href="/admin/orders/<%= order.id %>"><strong><%= order.orderNumber %></strong><span><%= statusLabel(order.orderStatus) %></span></a><% }); %><% } else { %><p>Choose a conversation to see customer and order information.</p><% } %></aside>
    </div>
  <% } %>
</main></div>
<dialog class="admin-confirm-dialog" id="admin-confirm" aria-labelledby="admin-confirm-title"><div class="drawer-header"><div><p class="eyebrow">PLEASE CONFIRM</p><h2 id="admin-confirm-title">Continue with this change?</h2></div></div><p id="admin-confirm-message">This action will update store records.</p><div class="confirm-actions"><button class="button button-light" id="admin-confirm-cancel" type="button">Go back</button><button class="button button-dark" id="admin-confirm-proceed" type="button">Continue <span>→</span></button></div></dialog>
</body></html>
