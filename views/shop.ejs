<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#fff" /><title><%= title %></title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" /><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /><link rel="stylesheet" href="/css/premium.css?v=3" /><link rel="stylesheet" href="/css/mobile.css?v=4" /><script src="/js/app.js?v=4" defer></script></head>
<body><a class="skip-link" href="#main">Skip to content</a><%- include('partials/store-header') %>
<main id="main" class="page-width commerce-page">
  <div class="breadcrumb"><a href="/">Home</a><span>/</span><span><%= category?.name || 'Shop' %></span></div>
  <section class="commerce-heading"><p class="eyebrow">THE MACPOINT COLLECTION</p><h1><%= category?.name || 'Find your next favourite.' %></h1><p><%= category?.description || 'Thoughtful technology, selected to make every day a little easier.' %></p></section>
  <div class="shop-layout">
    <aside class="shop-sidebar"><details class="shop-filter-panel" open><summary><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 17h16M8 4v6M16 14v6"/></svg>Filters & sort<span aria-hidden="true">+</span></summary><form action="/shop" method="get" class="filter-form">
      <h2>Refine your search</h2><label>Search<input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Product name, model, SKU" /></label>
      <label>Category<select name="category"><option value="">All categories</option><% categories.forEach(function(item) { %><option value="<%= item.name %>" <%= (filters.category || category?.name) === item.name ? 'selected' : '' %>><%= item.name %></option><% }); %></select></label>
      <div class="filter-pair"><label>From ৳<input type="number" name="minPrice" min="0" value="<%= filters.minPrice || '' %>" /></label><label>To ৳<input type="number" name="maxPrice" min="0" value="<%= filters.maxPrice || '' %>" /></label></div>
      <label>Capacity / option<select name="size"><option value="">Any option</option><% [...new Set(products.flatMap(function(product) { return product.variants.map(function(variant) { return variant.name; }); }))].forEach(function(option) { %><option value="<%= option %>" <%= filters.size === option ? 'selected' : '' %>><%= option %></option><% }); %></select></label>
      <label>Campaign<select name="tag"><option value="">All campaigns</option><% [...new Set(products.flatMap(function(product) { return product.tags || []; }))].forEach(function(tag) { %><option value="<%= tag %>" <%= filters.tag === tag ? 'selected' : '' %>><%= tag.replaceAll('-', ' ') %></option><% }); %></select></label>
      <label>Sort by<select name="sort"><option value="newest" <%= !filters.sort || filters.sort === 'newest' ? 'selected' : '' %>>New arrivals</option><option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option><option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option><option value="best_seller" <%= filters.sort === 'best_seller' ? 'selected' : '' %>>Best sellers</option></select></label>
      <button class="button button-dark" type="submit">Apply filters <span>→</span></button><a class="text-link" href="/shop">Clear filters</a>
    </form><div class="sidebar-categories"><h2>Shop by category</h2><% categories.forEach(function(item) { %><a href="/category/<%= item.slug %>"><span><%= item.name %></span><span><%= item.productCount || '' %></span></a><% }); %></div></details></aside>
    <section class="shop-results" aria-label="Products"><div class="shop-results-head"><p><strong><%= products.length %></strong> <%= products.length === 1 ? 'thoughtful pick' : 'thoughtful picks' %><% if (filters.q) { %> for “<%= filters.q %>”<% } %></p><span>Prices in BDT</span></div>
      <% if (products.length) { %><div class="product-grid" id="product-grid"><% products.forEach(function(product, index) { %><%- include('partials/product-card', { product, index }) %><% }); %></div><% } else { %><div class="empty-state"><span class="editorial-mark" aria-hidden="true">M.</span><h2>Nothing in this part of the collection yet.</h2><p>Try another category, price range, or search.</p><a class="button button-dark" href="/shop">Explore all products <span>→</span></a></div><% } %>
    </section>
  </div>
</main><%- include('partials/store-footer') %><%- include('partials/store-overlays') %></body></html>
