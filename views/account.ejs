<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /><link rel="stylesheet" href="/css/premium.css?v=3" /><link rel="stylesheet" href="/css/mobile.css?v=4" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><%- include('partials/store-header') %><main id="main" class="page-width commerce-page account-page">
  <section class="commerce-heading"><p class="eyebrow">YOUR MACPOINT ACCOUNT</p><h1>Hello, <%= currentUser.name.split(' ')[0] %>.</h1><p>Your orders, delivery details, and account information in one place.</p></section>
  <div class="account-layout"><aside class="account-nav"><a href="/account" class="<%= section === 'overview' ? 'is-active' : '' %>">Overview</a><a href="/account/wishlist" class="<%= section === 'wishlist' ? 'is-active' : '' %>">Wishlist</a><a href="/account/addresses" class="<%= section === 'addresses' ? 'is-active' : '' %>">Delivery addresses</a><form action="/logout" method="post"><button type="submit">Sign out</button></form></aside>
  <section class="account-content">
    <% if (section === 'addresses') { %><div class="content-heading"><div><p class="eyebrow">SAVED FOR NEXT TIME</p><h2>Your delivery addresses</h2></div></div>
      <div class="address-grid"><% addresses.forEach(function(address) { %><article class="address-card"><div><strong><%= address.label %></strong><% if (address.isDefault) { %><span class="status-pill">Default</span><% } %></div><p><%= address.name %><br /><%= address.phone %><br /><%= address.address %>, <%= address.city %></p><% if (!address.isDefault) { %><form action="/account/addresses/<%= address.id %>/default" method="post"><button class="text-link">Make default</button></form><% } %></article><% }); %></div>
      <form class="form-card address-form" method="post" action="/account/addresses"><p class="eyebrow">ADD AN ADDRESS</p><div class="form-grid"><label>Label<input name="label" placeholder="Home, Office" /></label><label>Recipient name<input name="name" required /></label><label>Mobile number<input name="phone" type="tel" required /></label><label>City / district<input name="city" required /></label><label class="field-wide">Address<textarea name="address" rows="2" required></textarea></label><label>Delivery area<select name="zone"><option value="dhaka">Inside Dhaka</option><option value="outside_dhaka">Outside Dhaka</option></select></label><label class="check-field"><input type="checkbox" name="isDefault" /> Make default</label></div><button class="button button-dark" type="submit">Save address <span>→</span></button></form>
    <% } else if (section === 'wishlist') { %><div class="content-heading"><div><p class="eyebrow">SAVED FOR LATER</p><h2>Your wishlist</h2></div><a class="text-link" href="/shop">Explore products <span>→</span></a></div>
      <% if (wishlistProducts.length) { %><div class="product-grid"><% wishlistProducts.forEach(function(product, index) { %><%- include('partials/product-card', { product, index }) %><% }); %></div><% } else { %><div class="empty-state"><h2>A little room for something lovely.</h2><p>Tap the heart on a product to save it here.</p><a class="button button-dark" href="/shop">Browse products <span>→</span></a></div><% } %>
    <% } else { %>
      <div class="account-metrics"><article><span>Total orders</span><strong><%= orders.length %></strong></article><article><span>Lifetime spend</span><strong>৳<%= formatPrice(totalSpent) %></strong></article><article><span>Invoices</span><strong><%= invoices.length %></strong></article></div>
      <div class="content-heading"><div><p class="eyebrow">THE DETAILS, ALL HERE</p><h2>Recent orders</h2></div><a class="text-link" href="/shop">Shop the collection <span>→</span></a></div>
      <% if (orders.length) { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Placed</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody><% orders.forEach(function(order) { %><tr><td><strong><%= order.orderNumber %></strong></td><td><%= new Date(order.createdAt).toLocaleDateString('en-BD') %></td><td><span class="status-pill"><%= statusLabel(order.orderStatus) %></span></td><td>৳<%= formatPrice(order.total) %></td><td><a class="text-link" href="/account/orders/<%= order.id %>">Details</a></td></tr><% }); %></tbody></table></div><% } else { %><div class="empty-state"><h2>Your next great idea starts here.</h2><p>When you place an order, we’ll keep its progress and invoice here.</p><a class="button button-dark" href="/shop">Explore the collection <span>→</span></a></div><% } %>
      <form class="form-card profile-form" method="post" action="/account/profile"><p class="eyebrow">ACCOUNT DETAILS</p><div class="form-grid"><label>Name<input name="name" value="<%= currentUser.name %>" required /></label><label>Email<input type="email" name="email" value="<%= currentUser.email || '' %>" /></label><label class="field-wide">New password <span class="optional-label">Optional · at least 8 characters</span><input type="password" name="password" minlength="8" autocomplete="new-password" /></label></div><button class="button button-dark" type="submit">Save details <span>→</span></button></form>
    <% } %>
  </section></div>
</main><%- include('partials/store-footer') %><%- include('partials/store-overlays') %><script src="/js/app.js?v=4" defer></script></body></html>
