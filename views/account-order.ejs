<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><%- include('partials/store-header') %><main id="main" class="page-width commerce-page">
<div class="breadcrumb"><a href="/account">Your account</a><span>/</span><span><%= order.orderNumber %></span></div><section class="commerce-heading"><p class="eyebrow">ORDER PLACED <%= new Date(order.createdAt).toLocaleDateString('en-BD') %></p><h1><%= order.orderNumber %></h1><p><span class="status-pill"><%= statusLabel(order.orderStatus) %></span> · Cash on delivery</p></section>
<section class="order-tracker"><ol class="fulfillment-stepper"><% ['pending','confirmed','processing','packed','shipped','out_for_delivery','delivered'].forEach(function(status, index) { %><li class="<%= order.timeline.some(function(item) { return item.status === status; }) ? 'is-complete' : '' %>"><span><%= index + 1 %></span><strong><%= statusLabel(status) %></strong></li><% }); %></ol></section>
<div class="account-order-grid"><section class="form-card"><p class="eyebrow">ITEMS IN THIS ORDER</p><% order.items.forEach(function(item) { %><article class="order-line"><img src="<%= item.image %>" alt="" /><div><strong><%= item.productName %></strong><span><%= item.variantName %><%= item.color ? ' · ' + item.color : '' %> · Qty <%= item.quantity %></span></div><strong>৳<%= formatPrice(item.total) %></strong></article><% }); %><div class="summary-lines"><p><span>Subtotal</span><strong>৳<%= formatPrice(order.subtotal) %></strong></p><p><span>Discount</span><strong>৳<%= formatPrice(order.discount) %></strong></p><p><span>Delivery</span><strong>৳<%= formatPrice(order.deliveryCharge) %></strong></p><p class="summary-total"><span>Total</span><strong>৳<%= formatPrice(order.total) %></strong></p></div></section>
<aside class="form-card"><p class="eyebrow">DELIVERING TO</p><h2><%= order.shippingName %></h2><p><%= order.shippingPhone %><br /><%= order.shippingAddress %><br /><%= order.shippingCity %></p><p class="eyebrow">ORDER TIMELINE</p><ol class="timeline-list"><% order.timeline.slice().reverse().forEach(function(event) { %><li><span><%= statusLabel(event.status) %></span><time><%= new Date(event.createdAt).toLocaleString('en-BD') %></time><p><%= event.note %></p></li><% }); %></ol><a class="text-link" href="/account/invoices/<%= (invoiceId || '') %>">View invoice</a></aside></div>
</main><%- include('partials/store-footer') %><%- include('partials/store-overlays') %><script src="/js/app.js?v=2.2.0" defer></script></body></html>
