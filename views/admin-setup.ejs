<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title><%= title %></title><link rel="icon" href="/favicon.svg" /><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=4" /><link rel="stylesheet" href="/css/commerce.css?v=4" /><link rel="stylesheet" href="/css/premium.css?v=4" /><link rel="stylesheet" href="/css/mobile.css?v=4" /><script src="/js/auth.js?v=4" defer></script></head>
<body class="auth-body auth-redesign admin-auth"><a class="skip-link" href="#setup">Skip to setup</a><main class="auth-shell"><%- include('partials/auth-brand') %><div class="auth-form-side"><div class="auth-page-top"><a class="brand" href="/"><span class="brand-mark">M</span><span class="brand-word">MacPoint</span></a><a class="auth-back" href="/">Back to store ↗</a></div><section class="auth-card" id="setup" aria-labelledby="setup-title"><p class="eyebrow">A GOOD PLACE TO START · ONE-TIME SETUP</p><h1 id="setup-title">Make it your store.</h1><p class="auth-description">Create your first administrator. You’ll be able to manage products, orders, customers, and staff.</p>
<% if (message) { %><div class="auth-error" role="alert"><span aria-hidden="true">!</span><p><%= message %></p></div><% } %>
<form method="post" action="/admin/setup" data-auth-form="setup"><label for="setup-name">Your name</label><input id="setup-name" name="name" autocomplete="name" placeholder="Your full name" required /><label for="setup-email">Administrator email</label><input id="setup-email" type="email" name="email" autocomplete="email" autocapitalize="none" spellcheck="false" placeholder="you@yourstore.com" required /><label for="setup-password">Create a password <small>At least 12 characters</small></label><div class="password-field"><input id="setup-password" type="password" name="password" minlength="12" autocomplete="new-password" required /><button type="button" data-toggle-password="setup-password" aria-label="Show password" aria-pressed="false">Show</button></div><label for="confirm-password">Confirm password</label><div class="password-field"><input id="confirm-password" type="password" name="confirmPassword" minlength="12" autocomplete="new-password" required /><button type="button" data-toggle-password="confirm-password" aria-label="Show password" aria-pressed="false">Show</button></div><button class="button button-dark auth-submit" type="submit" data-label="Create administrator"><span data-submit-label>Create administrator</span><span aria-hidden="true">→</span></button></form><p class="auth-note">This account receives Super Admin access. First-time setup closes automatically after your account is created.</p><a class="auth-alternate" href="/admin/login">Already have an administrator account? Sign in ↗</a></section><p class="auth-page-foot">© <%= year %> MacPoint <span>Your next chapter starts here.</span></p></div></main></body></html>
