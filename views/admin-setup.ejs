<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body class="auth-body"><main class="auth-layout"><a class="brand" href="/"><span class="brand-mark">M<span>.</span></span><span class="brand-word">MACPOINT</span></a><section class="auth-card"><p class="eyebrow">STORE SETUP · ONE TIME</p><h1>Create your store administrator.</h1><p>This first account will have full control of the catalog and operations.</p><% if (message) { %><p class="form-message form-error" role="alert"><%= message %></p><% } %><form method="post" action="/admin/setup"><label>Your name<input name="name" autocomplete="name" required /></label><label>Administrator email<input type="email" name="email" autocomplete="email" required /></label><label>Password <span class="optional-label">At least 12 characters</span><input type="password" name="password" minlength="12" autocomplete="new-password" required /></label><button class="button button-dark" type="submit">Create administrator <span>→</span></button></form><a class="text-link" href="/">Return to MacPoint</a></section></main></body></html>
