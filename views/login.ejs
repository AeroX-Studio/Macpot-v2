<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %></title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/css/styles.css?v=2.2.0" /><link rel="stylesheet" href="/css/commerce.css?v=2.2.0" /></head>
<body class="auth-body"><main class="auth-layout"><a class="brand" href="/"><span class="brand-mark">M<span>.</span></span><span class="brand-word">MACPOINT</span></a><section class="auth-card"><p class="eyebrow">WELCOME BACK</p><h1>Sign in to your account.</h1><p>Follow orders and keep your details close.</p><% if (message) { %><p class="form-message form-error" role="alert"><%= message %></p><% } %><form method="post" action="/login"><input type="hidden" name="next" value="<%= next %>" /><label>Email or mobile number<input name="identity" autocomplete="username" required /></label><label>Password<input type="password" name="password" autocomplete="current-password" required /></label><button class="button button-dark" type="submit">Sign in <span>→</span></button></form><p>New to MacPoint? <a href="/register">Create an account</a></p><% if (setupAvailable) { %><p class="setup-note">First time setting up this store? <a href="/admin/setup">Create the store administrator</a></p><% } %></section></main></body></html>
